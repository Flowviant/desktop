<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": the NSIS installer built around
  the already-signed app (.github/workflows/release.yml, "Sign the installer").
  SignPath cannot open an NSIS installer to sign what is inside, which is why
  the app is signed first, in its own request.
  A copy for review: SignPath reads the configuration stored in the SignPath
  project, so a change here is made there too.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Flowviant-Machines-*-setup.exe" product-name="Flowviant" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
