{
  "name": "desktop",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:daemon && tauri dev",
    "build": "bun run prepare:daemon && tauri build",
    "prepare:daemon": "bun scripts/prepare-daemon.mjs",
    "web:build": "vite build",
    "web:dev": "vite --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bun run test:rust",
    "test:rust": "sh scripts/test-rust.sh"
  },
  "dependencies": {
    "@flowviant/shared": "*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^14.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
